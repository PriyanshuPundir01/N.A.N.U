# Example Environment Configuration (SAFE FOR GITHUB)
# Copy this file to .env and fill in your actual private keys:
# cp .env.example .env

PORT=3000
CLIENT_TOKEN=change-this-client-token

# Google Gemini API Key (Get free from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (Optional - Get free from https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenAI API Key (Optional)
LLM_API_KEY=your_openai_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gemini-flash-lite-latest
 
# Gmail / SMTP Email Dispatch (Optional - for sending live OTPs directly to user inbox)
# Requires a 16-character Google App Password from: https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password
